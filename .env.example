# Copy to .env for a NEW installation. Preserve the existing .env during migration.
# Generate independent secrets; these values are intentionally nonfunctional.
WAHA_API_KEY=replace-with-a-generated-api-key
WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=replace-with-dashboard-username
WAHA_DASHBOARD_PASSWORD=replace-with-a-generated-dashboard-password
WHATSAPP_SWAGGER_ENABLED=false
WHATSAPP_SWAGGER_USERNAME=replace-with-swagger-username
WHATSAPP_SWAGGER_PASSWORD=replace-with-a-generated-swagger-password

WHATSAPP_DEFAULT_ENGINE=WEBJS
WAHA_NAMESPACE=all
# Preserve the default WEBJS session namespace. Do not change for existing sessions.
# WAHA_SESSION_NAMESPACE=webjs
WAHA_SESSION_NAME=session_01m5amp8ak239hr4cs57ydvaqm
WAHA_WORKER_RESTART_SESSIONS=true
WAHA_BASE_URL=http://127.0.0.1:3001
WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=False

WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_FOLDER=/app/.media
WHATSAPP_FILES_LIFETIME=0

# Enable only after configuring the same secret in NestJS WAHA_WEBHOOK_SECRET.
# Use an HTTPS backend URL in production; host.docker.internal reaches host NestJS on Docker Desktop.
# WHATSAPP_HOOK_URL=http://host.docker.internal:5050/api/v1/whatsapp/webhook
# WHATSAPP_HOOK_EVENTS=session.status,message.ack
# WHATSAPP_HOOK_HMAC_KEY=replace-with-a-generated-shared-webhook-secret
# WHATSAPP_HOOK_RETRIES_POLICY=linear
# WHATSAPP_HOOK_RETRIES_DELAY_SECONDS=2
# WHATSAPP_HOOK_RETRIES_ATTEMPTS=4
