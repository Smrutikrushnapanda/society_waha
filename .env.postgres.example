# Copy to .env.postgres AFTER provisioning the two WAHA databases and approving cutover.
# Use a dedicated WAHA role, never the NestJS application database owner or Neon owner.
# Use the Neon DIRECT endpoint (no -pooler) and existing maintenance database postgres.
# URL-encode username/password. The TLS preload verifies the server certificate.
WHATSAPP_SESSIONS_POSTGRESQL_URL=postgresql://waha_runtime:replace-with-url-encoded-password@replace-with-direct-endpoint.neon.tech:5432/postgres?sslmode=verify-full

# Optional PostgreSQL media storage (enabled by default in Render Dockerfile/render.yaml;
# keep LOCAL for local Docker Compose unless removing the ./media bind mount).
# WAHA_MEDIA_STORAGE=POSTGRESQL
# WAHA_MEDIA_POSTGRESQL_URL=postgresql://waha_runtime:replace-with-url-encoded-password@replace-with-direct-endpoint.neon.tech:5432/postgres?sslmode=verify-full

# Required by verification scripts. Keep the existing account's session name unchanged.
WAHA_SESSION_NAME=session_01m5amp8ak239hr4cs57ydvaqm
